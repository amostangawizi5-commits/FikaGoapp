# ============================================================
# FIKAGO - ENVIRONMENT TEMPLATE
# Copy this to .env.development and fill in real values
# ============================================================
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fikago_db_dev
DB_USER=your_db_user
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

PORT=5000

GOOGLE_MAPS_API_KEY=your_google_maps_key

SELCOM_API_KEY=your_selcom_key
SELCOM_API_SECRET=your_selcom_secret
SELCOM_VENDOR_ID=your_vendor_id
SELCOM_ENVIRONMENT=sandbox

OTP_EXPIRY_MINUTES=5
