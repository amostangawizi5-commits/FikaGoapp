# ============================================================
# FIKAGO - ENVIRONMENT TEMPLATE
# Copy this to .env.development and fill in real values
# ============================================================
NODE_ENV=development

# Use DATABASE_URL for a hosted PostgreSQL provider, or the DB_* fields below locally.
DATABASE_URL=
DB_POOL_MAX=3

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fikago_db_dev
DB_USER=your_db_user
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

PORT=5000

GOOGLE_MAPS_API_KEY=your_google_maps_key

SELCOM_API_KEY=your_selcom_key
SELCOM_API_SECRET=your_selcom_secret
SELCOM_VENDOR_ID=your_vendor_id
SELCOM_ENVIRONMENT=sandbox

OTP_EXPIRY_MINUTES=5

# Vercel adds this automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=
